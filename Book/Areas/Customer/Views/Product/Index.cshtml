                    @foreach(var obj in Model)
                    {
                        
                    <tr>
                            <td class="fw-medium" style="color: #1e293b;">@obj.CategoryId</td>
                            <td class="fw-medium" style="color: #1e293b;">@obj.Title</td>
                        <td class="text-end">
                            <a asp-action="Update" asp-route-id="@obj.CategoryId" class="btn btn-sm btn-outline-success me-1"><i class="bi bi-pencil-square me-1"></i>Edit</a>
